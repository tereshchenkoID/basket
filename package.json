{
  "name": "basket",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/auth.test.ts tests/validation.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "npm run lint && npm run stylelint && npm run typecheck && npm test",
    "test:db": "node --import tsx --test tests/database.test.ts",
    "db:types": "node scripts/generate-types.mjs",
    "stylelint": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix --max-warnings=0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.107.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "pg": "8.23.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.3",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
